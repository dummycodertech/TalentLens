# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml to git — it is in .gitignore.

# Groq API (free tier) — get at https://console.groq.com
GROQ_API_KEY = "gsk_..."

# GitHub Personal Access Token — https://github.com/settings/tokens
# Scopes needed: public_repo (read-only is fine)
GITHUB_PAT = "ghp_..."

# Gmail account + App Password
# App password setup: https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on the account)
GMAIL_ADDRESS = "you@gmail.com"
GMAIL_APP_PASSWORD = "xxxx xxxx xxxx xxxx"

# Google Calendar OAuth2 token (base64-encoded JSON)
# Generate locally: python -c "from modules.calendar_scheduler import generate_token_locally; generate_token_locally('client_secret.json')"
# Then copy the printed base64 string here.
GOOGLE_OAUTH_CLIENT_JSON = "<base64-encoded token JSON>"

# Recruiter's Google account email (for Calendar event organizer + attendee)
RECRUITER_EMAIL = "you@gmail.com"
